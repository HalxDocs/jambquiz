rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── STUDENTS ───
    // Anyone can read by name for login, create for register.
    // Updates only through backend admin.
    match /students/{studentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ─── SCORES ───
    // Students read their own scores (checked by studentId field).
    // Create allowed for quiz submission.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.studentId is string;
      allow update, delete: if false;
    }

    // ─── QUESTIONS ───
    // Read-only for everyone, write only from backend/admin.
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── TOPICS ───
    // Read-only for everyone.
    match /topics/{topicId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── SETTINGS ───
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── PAYMENTS ───
    match /payments/{paymentId} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    // ─── PUSH SUBSCRIPTIONS ───
    match /push_subscriptions/{studentId} {
      allow read, write: if true;
    }

    // ─── NOTIFICATION STATE ───
    match /notification_state/{studentId} {
      allow read, write: if true;
    }

    // ─── ADMIN SETTINGS ───
    match /admin_settings/{docId} {
      allow read, write: if false;
    }

    // ─── QUESTION LIMITS ───
    match /question_limits/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── ADMIN BROADCASTS ───
    // Admin writes via client; everyone reads for in-app display.
    match /admin_broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ─── LEADERBOARD (aggregated) ───
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
